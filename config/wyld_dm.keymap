//#include <dt-bindings/led/led.h>

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

//#include <dt-bindings/zmk/rgb.h>
// triggering build

#define QWERTY 0
#define LOWER 1
#define RAISE 2

//# 4x6 with encoders

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC  &kp GRAVE              &kp N1    &kp N2    &kp N3    &kp N4            &kp N5                                            &kp N6                    &kp N7         &kp N8      &kp N9     &kp N0    &kp MINUS         &kp EQUAL
&kp F1   &kp TAB                &kp Q     &kp W     &kp E     &kp R             &kp T                                             &kp Y                     &kp U          &kp I       &kp O      &kp P     &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp F2   &mt LEFT_SHIFT CAPS    &kp A     &kp S     &kp D     &kp F             &kp G                     &kp K_MUTE    &kp HOME  &kp H                     &kp J          &kp K       &kp L      &kp SEMI  &kp SQT           &kp BSLH
&kp F3   &kp LA(LC(LG(LSHFT)))  &kp Z     &kp X     &kp C     &kp V             &kp B                                             &kp N                     &kp M          &kp COMMA   &kp DOT    &kp FSLH  &kp RSHFT         &kp F5
&kp F4   &kp LCTRL              &kp LGUI  &kp LBKT  &kp RBKT                                                                                                               &kp DELETE  &kp RGUI   &kp RALT  &kp RCTRL         &kp F6
                                                              &mo RAISE         &kp SPACE                                         &kp ENTER                 &mo LOWER
                                                              &kp LEFT_COMMAND  &mt LEFT_SHIFT BACKSPACE                          &mt RIGHT_CONTROL DELETE  &kp RIGHT_ALT
                                          &kp UP    &kp DOWN                                                                                                               &kp LEFT    &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&bt BT_CLR   &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_BLE                    &out OUT_USB  &trans     &trans           &trans    &trans    &trans    &trans
&sys_reset   &kp GRAVE         &kp EXCL           &kp AT             &kp HASH      &kp DOLLAR    &kp PRCNT                       &kp CARET     &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &trans    &sys_reset
&trans       &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &bootloader   &trans        &trans        &trans    &trans  &trans        &kp MINUS  &kp KP_PLUS      &kp LBRC  &kp RBRC  &kp PIPE  &trans
&trans       &trans            &trans             &trans             &trans        &trans        &trans                          &trans        &trans     &trans           &trans    &trans    &trans    &trans
&bootloader  &trans            &trans             &trans             &trans                                                                               &trans           &trans    &trans    &trans    &bootloader
                                                                                   &trans        &trans                          &trans        &trans
                                                                                   &trans        &trans                          &trans        &trans
                                                  &trans             &trans                                                                               &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&trans  &trans  &trans  &trans    &trans        &trans     &trans                      &kp RBKT  &kp KP_N7  &kp KP_N8   &kp KP_N9     &kp KP_DIVIDE    &trans  &trans
&trans  &trans  &trans  &trans    &kp UP_ARROW  &trans     &kp LBKT                    &kp RPAR  &kp KP_N4  &kp KP_N5   &kp KP_N6     &kp KP_MULTIPLY  &trans  &trans
&trans  &trans  &trans  &kp DOWN  &kp DOWN      &kp RIGHT  &kp LPAR  &trans    &trans  &trans    &kp KP_N1  &kp KP_N2   &kp KP_N3     &kp KP_MINUS     &trans  &trans
&trans  &trans  &trans  &trans    &trans        &trans     &trans                      &trans    &kp KP_N0  &kp KP_DOT  &kp KP_EQUAL  &kp KP_PLUS      &trans  &trans
&trans  &trans  &trans  &trans    &trans                                                                    &trans      &trans        &trans           &trans  &trans
                                                &trans     &trans                      &trans    &trans
                                                &trans     &trans                      &trans    &trans
                        &trans    &trans                                                                    &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
